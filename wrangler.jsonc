{
  "name": "woogidex",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  // worker/index.js only handles /sb/*, the reverse proxy that puts Supabase
  // API traffic behind this zone's WAF and rate limiting rules. Every other
  // path is served straight from the asset store without running a Worker,
  // which is both faster and free -- that is what run_worker_first buys.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/sb/*"]
  }
}
